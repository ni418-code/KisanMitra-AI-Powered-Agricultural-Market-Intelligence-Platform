# Copy this file to ".env" and fill in your own values. Never commit the real .env file.

# Your MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI= mongodb+srv://kmfb:kmfb12345@cluster0.fqlhyzi.mongodb.net/?appName=Cluster0

# Any long random string, used to sign login tokens
JWT_SECRET=bc1aba17f77fdb34edadc4d1994a0ddf334ac484e9e763ac36e691d92686f440

# Port the API server listens on
PORT=5000

# data.gov.in API key for the AGMARKNET "current daily price" dataset.
# Get a free key at https://data.gov.in/user/register (or https://data.gov.in -> My Account -> API Key)
DATA_GOV_IN_API_KEY=579b464db66ec23bdd0000019a26e4b0b50e4b0572414bd3327df4b5
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# How often the market-price sync job runs (cron syntax). Default: every 30 minutes.
MARKET_SYNC_CRON=*/30 * * * *

# Comma-separated list of origins allowed to call this API (your frontend URLs)
CORS_ORIGIN=http://localhost:5173
